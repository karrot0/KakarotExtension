{
  "name": "kakarotextension",
  "description": "Mangafire extension",
  "author": "Karrot",
  "keywords": [
    "Paperback",
    "extensions"
  ],
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karrot0/KakarotExtension.git"
  },
  "bugs": {
    "url": "https://github.com/karrot0/KakarotExtension/issues"
  },
  "homepage": "https://github.com/karrot0/KakarotExtension#readme",
  "repositoryName": "KakarotExtension",
  "repositoryDescription": "Mangafire extension",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format": "prettier --write '**/*{.md,.yml,.yaml,.json,.js,.ts}'",
    "format:check": "prettier --check '**/*{.md,.yml,.yaml,.json,.js,.ts}'",
    "bundle": "paperback-cli bundle",
    "serve": "paperback-cli serve",
    "logcat": "paperback-cli logcat",
    "dev": "paperback-cli serve -w",
    "test": "tsc --project tsconfig.json --noEmit && npm run lint:check && npm run format:check && npm run bundle",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@paperback/toolchain": "^1.0.0-alpha.50",
    "@paperback/types": "^1.0.0-alpha.50",
    "@types/eslint": "^9.6.1",
    "cheerio": "^1.1.0",
    "eslint": "^9.28.0",
    "fastest-levenshtein": "^1.0.16",
    "husky": "^9.1.7",
    "moment": "^2.30.1",
    "prettier": "^3.5.3",
    "stemmer": "^2.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "dependencies": {
    "@types/node": "^22.15.30",
    "cheerio": "^1.1.0",
    "jsdom": "^26.1.0"
  }
}
