{
  "name": "kakarotextension",
  "description": "Kakarot extensions for Paperback",
  "author": "Karrot",
  "keywords": [
    "Paperback",
    "extensions"
  ],
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karrot0/KakarotExtension.git"
  },
  "bugs": {
    "url": "https://github.com/karrot0/KakarotExtension/issues"
  },
  "homepage": "https://github.com/karrot0/KakarotExtension#readme",
  "repositoryName": "KakarotExtension",
  "repositoryDescription": "Kakarot extensions for Paperback",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsc": "tsc",
    "bundle": "paperback-cli bundle",
    "test": "npx --package @paperback/toolchain@1.0.0-alpha.78 paperback-cli test --noConsole --output ./bundles/tests.json",
    "serve": "paperback-cli serve",
    "logcat": "paperback-cli logcat",
    "dev": "paperback-cli serve --watch --port 3000",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@paperback/toolchain": "1.0.0-alpha.78",
    "@paperback/types": "1.0.0-alpha.78",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "patch-package": "^8.0.1"
  }
}
