+import { bundle } from "../bundle/index.mjs";
+import { clearConsole, prefixTime, startFileWatcher } from "../../toolchain/serve.mjs";
+import { startServer } from "../../toolchain/http-server.mjs";
+import path from "node:path";
+import pc from "picocolors";
+import readline from "node:readline/promises";
+
+//#region src/commands/serve/index.ts
+const bundleFlags = {
+	debug: false,
+	tests: false
+};
+let rebuildDebounce;
+let isRebuilding = false;
+async function serve(flags) {
+	clearConsole();
+	console.log(pc.underline(pc.blue("Building Sources")));
+	await bundle.bind(this)(bundleFlags);
+	console.log("\n", pc.underline(pc.blue("Starting Server on port " + flags.port)));
+	let server = startServer(flags.port);
+	console.log(`\nFor a list of commands do ${pc.green("h")} or ${pc.green("help")}`);
+	const rl = readline.createInterface({
+		input: process.stdin,
+		output: process.stdout
+	});
+	let rlSignal;
+	let watcher;
+	if (flags.watch) {
+		const srcDir = path.join(process.cwd(), "src");
+		console.log(pc.yellow(`Watching for changes in ${srcDir}`));
+		watcher = startFileWatcher(srcDir, (filename) => {
+			if (isRebuilding) return;
+			console.log(`file: ${filename} changed, scheduling rebuild`);
+			rlSignal?.abort();
+			if (rebuildDebounce != void 0) clearTimeout(rebuildDebounce);
+			rebuildDebounce = setTimeout(async () => {
+				isRebuilding = true;
+				server.close();
+				clearConsole();
+				console.log(pc.underline(pc.blue("Building Sources")));
+				await bundle.bind(this)(bundleFlags);
+				server = startServer(flags.port);
+				console.log(`\nFor a list of commands do ${pc.green("h")} or ${pc.green("help")}`);
+				rlSignal?.abort();
+				isRebuilding = false;
+			}, 500);
+		});
+	}
+	rl.on("SIGINT", () => {
+		if (watcher != void 0) {
+			console.log("\nStopping watcher...");
+			watcher.close();
+		}
+		console.log("\nStopping server...");
+		server.close();
+		rl.close();
+		process.exit(0);
+	});
+	let stopServer = false;
+	while (!stopServer) {
+		rlSignal = new AbortController();
+		let input;
+		try {
+			input = await rl.question(prefixTime(""), { signal: rlSignal.signal });
+		} catch {
+			continue;
+		}
+		if (input === "h" || input === "help") {
+			console.log(pc.underline(pc.bold("Help")));
+			console.log("  h, help - Display this message");
+			console.log("  s, stop - Stop the server");
+			console.log("  r, restart - Restart the server, also rebuilds the sources");
+		}
+		if (input === "s" || input === "stop") stopServer = true;
+		if (input === "r" || input === "restart") {
+			server.close();
+			clearConsole();
+			console.log(pc.underline(pc.blue("Building Sources")));
+			await bundle.bind(this)(bundleFlags);
+			server = startServer(flags.port);
+			console.log(`\nFor a list of commands do ${pc.green("h")} or ${pc.green("help")}`);
+		}
+	}
+	if (watcher != void 0) {
+		console.log("\nStopping watcher...");
+		watcher.close();
+	}
+	console.log("Stopping server...");
+	server.close();
+	rl.close();
+	process.exit(0);
+}
+
+//#endregion
+export { serve };
