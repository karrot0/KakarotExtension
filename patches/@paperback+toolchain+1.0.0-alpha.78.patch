-                        let parsedTime;
-                        if (seconds === 0 && minutes === 0) {
-                            parsedTime = `${Math.floor(duration)}ms`;
-                        }
-                        if (seconds > 0) {
-                            parsedTime = `${seconds % 60}s`;
-                        }
-                        if (minutes > 0) {
-                            parsedTime = `${minutes}m${parsedTime}`;
-                        }
-                        return parsedTime ?? '0.0s';
-                    },
-                    // @ts-expect-error type shenanigans
-                    format: () => color.dim,
-                },
-            },
-        });
-        await tasks.run();
-    }
