-                        title: file,
-                    };
-                }), { concurrent: true }),
-                title: 'Bundling Extensions',
-            },
-            {
-                task() {
-                    // fs.remove(path.join(cwd, 'tmp'))
-                },
-                title: 'Cleaning up',
-            },
-        ]);
-    }
-    async generateHomepage(folder = '') {
